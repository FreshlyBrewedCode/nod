{
  "name": "@frebreco/nod",
  "description": "Steer your team's attention across agent-written pull requests, and let humans nod them through with a signed attestation, so agents can merge on their own.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FreshlyBrewedCode/nod.git"
  },
  "bin": {
    "nod": "bin/nod.js"
  },
  "type": "module",
  "exports": {
    "./kit": "./src/kit/index.ts"
  },
  "scripts": {
    "dev": "vite",
    "serve": "bun src/cli.ts serve",
    "build": "vite build",
    "test": "bun test src",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "format": "oxfmt src bin vite.config.ts package.json",
    "format:check": "oxfmt --check src bin vite.config.ts package.json",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "engines": {
    "bun": ">=1.4.1"
  }
}
