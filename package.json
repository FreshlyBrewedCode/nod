{
  "name": "@frebreco/nod",
  "private": true,
  "description": "Steer your team's attention across agent-written pull requests, and let humans nod them through with a signed attestation, so agents can merge on their own.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FreshlyBrewedCode/nod.git"
  },
  "bin": {
    "nod": "bin/nod.js"
  },
  "type": "module",
  "exports": {
    "./kit": "./src/kit/index.ts"
  },
  "scripts": {
    "dev": "vite",
    "serve": "bun src/cli.ts serve",
    "build": "vite build",
    "test": "bun test src",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src templates",
    "format": "oxfmt src bin scripts templates vite.config.ts package.json .releaserc.json",
    "format:check": "oxfmt --check src bin scripts templates vite.config.ts package.json .releaserc.json",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test"
  },
  "dependencies": {
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/github": "12.0.9",
    "@semantic-release/npm": "13.1.5",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "conventional-changelog-conventionalcommits": "10.4.0",
    "lucide-react": "^1.48.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-resizable-panels": "^4.13.3",
    "semantic-release": "25.0.9",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "engines": {
    "bun": ">=1.4.1"
  }
}
