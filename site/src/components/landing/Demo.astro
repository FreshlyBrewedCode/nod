---
/*
 * A slice of the dashboard, rebuilt in HTML and CSS from the app's own rows
 * (src/web/components/pr-row.tsx, bits.tsx, diff-indicator.tsx) and the r3
 * fake team (src/server/fake-data.ts): Mara's view of tallyho/fieldbook.
 *
 * It is one picture in four states, `data-step` on the frame: two rows
 * selected, the batch dialog, the check green, the rows gone because their
 * agents merged them. `styles/landing.css` draws every state from that one
 * attribute; `scripts/landing.ts` only changes it. Without a script it is the
 * first state.
 *
 * The frame is an illustration (`role="img"`, one label): nothing in it can
 * be focused or clicked. The steps below it are the real controls.
 */

/** `+a −r` and the 38 px bar: length on a log scale to 1,000 lines (src/web/lib/diff.ts). */
function diff(added: number, removed: number) {
  const total = added + removed;
  const length = total === 0 ? 0 : Math.min(1, Math.log10(total + 1) / 3);
  return {
    added: `+${added}`,
    removed: `−${removed}`,
    a: `${((added / Math.max(total, 1)) * length * 100).toFixed(1)}%`,
    r: `${((removed / Math.max(total, 1)) * length * 100).toFixed(1)}%`,
  };
}

const MARA = 28;
const JONAS = 205;
const INES = 285;

const d = {
  auth: diff(148, 61),
  prorate: diff(312, 88),
  digest: diff(203, 140),
  stock: diff(121, 17),
  adr: diff(164, 0),
  bus: diff(684, 402),
  clusterBefore: diff(251, 132),
  clusterAfter: diff(251 + 312 + 203, 132 + 88 + 140),
};

const steps = [
  {
    name: "Select",
    text: "Tick what you have looked at. Your own work and a teammate's can go in one batch.",
  },
  {
    name: "Sign once",
    text: "One passphrase, one signature, made by a key the agents don't have.",
  },
  {
    name: "The check turns green",
    text: "The verifier in your repository checks the signature against your policy.",
  },
  {
    name: "The agents merge",
    text: "Auto-merge does the rest. What is left is what deserves reading.",
  },
];
---

<figure class="demo" data-demo>
  <div
    class="frame"
    data-step="0"
    role="img"
    aria-label="The nod dashboard for the fictional repository tallyho/fieldbook. Pull requests are shown in four sizes. Under Needs you, two of a teammate's pull requests are prominent, with a line of their brief, and two of your own are normal rows. Under Worth knowing, an FYI takes one line. Under Background, a stuck pull request takes one line and seven low-risk changes are folded into a single row. Two pull requests are selected for signing."
  >
    <div class="bar">
      <span class="brand">
        <svg viewBox="0 0 18 18" aria-hidden="true">
          <rect width="18" height="18" rx="5" fill="#f2b24a"></rect>
          <path
            d="M5 9.4l2.6 2.6L13 6.6"
            fill="none"
            stroke="#15120a"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        nod
      </span>
      <span class="repo">tallyho/fieldbook</span>
      <span class="seg"><b>List</b><span>Board</span></span>
      <span class="grow"></span>
      <span class="lock">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <rect x="5" y="11" width="14" height="9" rx="2"></rect>
          <path class="shackle" d="M8 11V8a4 4 0 0 1 8 0v3"></path>
        </svg>
        <span class="before-2">Locked</span>
        <span class="from-2">Unlocked <span class="mono">14:52</span></span>
      </span>
      <span class="av lg" style={`--h:${MARA}`}>M</span>
    </div>

    <div class="list">
      <div class="lane">
        <i class="dot need"></i>
        <b>Needs you</b>
        <span class="count"><span class="before-3">4</span><span class="from-3">2</span></span>
        <span class="aside">oldest waits 6 hours</span>
      </div>
      <div class="rows">
        <div class="row t1">
          <span class="note"><b>Prominent</b>high risk, or a teammate's work</span>
          <span class="box"></span>
          <div class="main">
            <div class="title">auth: rotate session tokens on privilege change</div>
            <div class="brief">
              When a user's role changes, all their sessions get a fresh token and the old ones are
              revoked within one request.
            </div>
            <div class="meta">
              <span class="av" style={`--h:${JONAS}`}>J</span>
              <span>Jonas · 6h</span>
              <span class="tag">core</span>
            </div>
          </div>
          <span class="diff">
            <span class="nums"><b>{d.auth.added}</b> <u>{d.auth.removed}</u></span>
            <i class="track"><b style={`width:${d.auth.a}`}></b><u style={`width:${d.auth.r}`}></u></i>
          </span>
          <span class="risk r3"><i></i><i></i><i></i></span>
          <span class="ask">Sign as owner</span>
        </div>

        <div class="fold">
          <div class="fold-in">
            <div class="row t1 batch">
              <span class="box"></span>
              <div class="main">
                <div class="title">billing: prorate plan changes mid-cycle</div>
                <div class="brief">
                  Adds day-based proration when a tenant switches plan mid-cycle; credit note for
                  downgrades, immediate charge for upgrades.
                </div>
                <div class="meta">
                  <span class="av" style={`--h:${JONAS}`}>J</span>
                  <span>Jonas · 2h</span>
                  <span class="tag">tier 3</span>
                </div>
              </div>
              <span class="diff">
                <span class="nums"><b>{d.prorate.added}</b> <u>{d.prorate.removed}</u></span>
                <i class="track"
                  ><b style={`width:${d.prorate.a}`}></b><u style={`width:${d.prorate.r}`}></u></i
                >
              </span>
              <span class="risk r2"><i></i><i></i><i></i></span>
              <span class="ask">
                <span class="before-2">Sign as peer</span>
                <span class="from-2 green"><i class="pip"></i>check green</span>
              </span>
            </div>
          </div>
        </div>

        <div class="fold">
          <div class="fold-in">
            <div class="row t2 batch">
              <span class="box"></span>
              <div class="main">
                <div class="title">notifications: batch digest emails per tenant</div>
                <div class="meta">
                  <span class="av" style={`--h:${MARA}`}>M</span>
                  <span>you · 49m</span>
                  <span class="tag">tier 2</span>
                </div>
              </div>
              <span class="diff">
                <span class="nums"><b>{d.digest.added}</b> <u>{d.digest.removed}</u></span>
                <i class="track"
                  ><b style={`width:${d.digest.a}`}></b><u style={`width:${d.digest.r}`}></u></i
                >
              </span>
              <span class="risk r2"><i></i><i></i><i></i></span>
              <span class="ask">
                <span class="before-2">Self-attest</span>
                <span class="from-2 green"><i class="pip"></i>check green</span>
              </span>
            </div>
          </div>
        </div>

        <div class="row t2">
          <span class="note"><b>Normal</b>your own work</span>
          <span class="box"></span>
          <div class="main">
            <div class="title">inventory: release stock when a reservation times out</div>
            <div class="meta">
              <span class="av" style={`--h:${MARA}`}>M</span>
              <span>you · 1h</span>
              <span class="tag">tier 2</span>
            </div>
          </div>
          <span class="diff">
            <span class="nums"><b>{d.stock.added}</b> <u>{d.stock.removed}</u></span>
            <i class="track"><b style={`width:${d.stock.a}`}></b><u style={`width:${d.stock.r}`}></u></i>
          </span>
          <span class="risk r1"><i></i><i></i><i></i></span>
          <span class="ask">Self-attest</span>
        </div>
      </div>

      <div class="lane">
        <i class="dot know"></i>
        <b>Worth knowing</b>
        <span class="count">1</span>
        <span class="aside">no input wanted</span>
      </div>
      <div class="rows">
        <div class="row t3">
          <span class="note"><b>One line</b>worth knowing, or stuck</span>
          <span></span>
          <div class="main line">
            <span class="title">docs: ADR-014 module tiers and review requirements</span>
            <span class="why">
              <span class="av" style={`--h:${INES}`}>I</span><span class="t">changes how we review</span>
            </span>
          </div>
          <span class="diff">
            <span class="nums"><b>{d.adr.added}</b> <u>{d.adr.removed}</u></span>
            <i class="track"><b style={`width:${d.adr.a}`}></b><u style={`width:${d.adr.r}`}></u></i>
          </span>
          <span class="risk r0"><i></i><i></i><i></i></span>
          <span class="ask know">Got it</span>
        </div>
      </div>

      <div class="lane">
        <i class="dot bg"></i>
        <b>Background</b>
        <span class="count"><span class="before-3">8</span><span class="from-3">10</span></span>
        <span class="aside">nothing to do</span>
      </div>
      <div class="rows">
        <div class="row t3">
          <span></span>
          <div class="main line">
            <span class="title">core: typed channels for the event bus</span>
            <span class="why"><span class="av" style={`--h:${MARA}`}>M</span><span class="t">you · 23h</span></span>
          </div>
          <span class="diff">
            <span class="nums"><b>{d.bus.added}</b> <u>{d.bus.removed}</u></span>
            <i class="track"><b style={`width:${d.bus.a}`}></b><u style={`width:${d.bus.r}`}></u></i>
          </span>
          <span class="risk r3"><i></i><i></i><i></i></span>
          <span class="status">waits on Ines</span>
        </div>
        <div class="row t4">
          <span class="note"><b>Folded</b>low risk, nothing to do</span>
          <span class="caret">▸</span>
          <div class="main line">
            <b class="cluster">
              <span class="before-3">7 low-risk changes</span>
              <span class="from-3">9 low-risk changes</span>
            </b>
            <span class="why">
              <span class="t before-3">3 deps · 2 tier 1 · 1 signed by you · 1 docs</span>
              <span class="t from-3">3 deps · 2 tier 1 · 3 signed by you · 1 docs</span>
            </span>
          </div>
          <span class="diff">
            <span class="nums before-3"
              ><b>{d.clusterBefore.added}</b> <u>{d.clusterBefore.removed}</u></span
            >
            <span class="nums from-3"><b>{d.clusterAfter.added}</b> <u>{d.clusterAfter.removed}</u></span>
            <i class="track before-3"
              ><b style={`width:${d.clusterBefore.a}`}></b><u style={`width:${d.clusterBefore.r}`}
              ></u></i
            >
            <i class="track from-3"
              ><b style={`width:${d.clusterAfter.a}`}></b><u style={`width:${d.clusterAfter.r}`}
              ></u></i
            >
          </span>
          <span></span>
          <span class="status">
            <span class="before-3">4 merged · 3 open</span>
            <span class="from-3">6 merged · 3 open</span>
          </span>
        </div>
      </div>
    </div>

    {/* Step 1: what is selected, and the one button. */}
    <div class="selbar">
      <b>2 selected</b>
      <span class="quiet">Clear</span>
      <span class="btn">Review &amp; sign 2 <kbd>s</kbd></span>
    </div>

    {/* Step 2: the batch dialog, with the unlock in place. */}
    <div class="shade"></div>
    <div class="dialog">
      <div class="d-title">Sign 2 pull requests</div>
      <p class="d-sum">
        You are signing 2 changes: 1 as peer, 1 your own. Both will be merged by their agents.
      </p>
      <div class="d-group">Jonas’s work · you sign as peer</div>
      <div class="d-row">
        <span class="box on"></span>
        <div>
          <div class="d-name">billing: prorate plan changes mid-cycle</div>
          <div class="meta">
            <span class="av" style={`--h:${JONAS}`}>J</span>
            <span>Jonas</span>
            <span class="nums"><b>{d.prorate.added}</b> <u>{d.prorate.removed}</u></span>
            <span class="risk r2"><i></i><i></i><i></i></span>
          </div>
        </div>
        <span class="d-out"><i class="pip"></i>check turns green, the agent merges</span>
      </div>
      <div class="d-group">Your work · you sign as prompter</div>
      <div class="d-row">
        <span class="box on"></span>
        <div>
          <div class="d-name">notifications: batch digest emails per tenant</div>
          <div class="meta">
            <span class="av" style={`--h:${MARA}`}>M</span>
            <span>you</span>
            <span class="nums"><b>{d.digest.added}</b> <u>{d.digest.removed}</u></span>
            <span class="risk r2"><i></i><i></i><i></i></span>
          </div>
        </div>
        <span class="d-out"><i class="pip"></i>check turns green, the agent merges</span>
      </div>
      <div class="d-unlock">
        <span class="field"><span class="dots">••••••••••••••••</span></span>
        <span class="chip on">for 15 minutes</span>
        <span class="chip">just this once</span>
      </div>
      <div class="d-foot">
        <span class="quiet">Cancel</span>
        <span class="btn lg">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <rect x="5" y="11" width="14" height="9" rx="2"></rect>
            <path d="M8 11V8a4 4 0 0 1 8 0v3"></path>
          </svg>
          Unlock and sign 2 <kbd>↵</kbd>
        </span>
      </div>
    </div>
  </div>

  <figcaption>
    <p class="legend">
      <b>Row size follows attention.</b> Four sizes: prominent, normal, one line, folded.
    </p>
    <ol class="steps">
      {
        steps.map((step, i) => (
          <li>
            <button type="button" data-go={i} aria-current={i === 0 ? "step" : undefined}>
              <span class="num">{i + 1}</span>
              <span class="name">{step.name}</span>
              <span class="text">{step.text}</span>
            </button>
          </li>
        ))
      }
    </ol>
    <button type="button" class="play" data-play hidden>
      <span data-play-label>Pause</span>
    </button>
  </figcaption>
</figure>
