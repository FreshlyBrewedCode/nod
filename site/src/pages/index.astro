---
import Demo from "../components/landing/Demo.astro";
import Base from "../layouts/Base.astro";
import { href } from "../lib/channel";
import "../styles/landing.css";

/*
 * The landing page: one sentence, the product itself, three points, the
 * limit, the way in, in one column and few words. Dark only, like the app it shows. The layout and the
 * demo's states are in `styles/landing.css`; the fictional team and repo are
 * the app's own fake data (src/server/fake-data.ts).
 */
---

<Base
  title="nod: see which pull requests need you, nod them, let the agents merge"
  scheme="dark"
>
  <main id="main" class="landing">
    <section class="hero">
      <p class="released">
        <a class="state" href={href("/docs/status")}>Prototype, not released yet</a>
      </p>
      <h1>See which pull requests need you, nod them, and let the agents merge.</h1>
      <div class="hero-rest">
        <p class="lead">
          A local dashboard that sizes every agent-written pull request by its risk. A signed nod
          from a human lets the agent merge.
        </p>
        <p class="actions">
          <a class="button primary" href={href("/docs/quick-start")}>Quick start</a>
          <a class="button" href={href("/docs")}>Docs</a>
          <a class="button bare" href="https://github.com/FreshlyBrewedCode/nod">GitHub</a>
        </p>
      </div>
    </section>

    <section aria-label="The dashboard and a nod, shown">
      <Demo />
    </section>

    <section class="section points" aria-label="In short">
      <div>
        <h2>Attention</h2>
        <p>What needs you is large; the rest takes a line or folds away.</p>
        <a class="more" href={href("/docs/dashboard")}>The dashboard</a>
      </div>
      <div>
        <h2>Attestation</h2>
        <p>A nod signs the exact content you looked at, with a key the agents don't have.</p>
        <a class="more" href={href("/docs/nodding")}>Nodding</a>
      </div>
      <div>
        <h2>Yours</h2>
        <p>The policy and the verifier are files in your repository: no GitHub App, no backend.</p>
        <a class="more" href={href("/docs/policy")}>The policy</a>
      </div>
    </section>

    <section class="section" aria-label="The limit">
      <p class="limit">
        The check comes from GitHub Actions, so nod guards against mistakes, not against an agent
        that sets out to forge it. <a class="more" href={href("/docs/security")}>Security and limits</a>
      </p>
    </section>

    <section class="section start" aria-labelledby="try-it">
      <div>
        <h2 id="try-it">Try it</h2>
        <p>Run it from a checkout, on a fictional team.</p>
        <a class="more" href={href("/docs/quick-start")}>Quick start</a>
      </div>
      <pre
        class="term"
        tabindex="0"
        aria-label="Commands to run nod from a checkout"><span class="p">$ </span>git clone https://github.com/FreshlyBrewedCode/nod && cd nod
<span class="p">$ </span>bun install
<span class="p">$ </span>bun run dev                   <span class="c"># the web app</span>
<span class="p">$ </span>bun src/cli.ts serve --fake   <span class="c"># second terminal; open its link</span></pre>
    </section>
  </main>
</Base>

<script>
  import "../scripts/landing.ts";
</script>
